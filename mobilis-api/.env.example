# Copie este arquivo para .env e ajuste se o Postgres local usar outra porta.
# Valores abaixo servem apenas para desenvolvimento. Nao use em producao.

SERVER_PORT=8081

DB_JDBC_URL=jdbc:postgresql://localhost:5432/mobilis
DB_USER=mobilis
DB_PASSWORD=mobilis
DB_POOL_MAX=10

# Minimo de 32 caracteres. Troque fora do ambiente local.
JWT_SECRET=dev-only-mobilis-jwt-secret-change-me-32
JWT_ISSUER=mobilis
JWT_EXPIRATION_HOURS=8
